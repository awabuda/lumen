{
  "$schema": "https://unpkg.com/@changesets/config@2.27.0/schema.json",
  "changelog": [
    "@changesets/cli/changelog",
    {
      "repo": "lumen"
    }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [],
  "snapshot": {
    "useCalculatedVersion": true,
    "prereleaseTemplate": "{tag}-{datetime}-{commit}"
  }
}
