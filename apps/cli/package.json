{
  "name": "@lumen/cli",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "bin": {
    "lumen": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/real-model",
    "bench": "LUMEN_BENCH=1 vitest run test/perf --reporter=verbose",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@lumen/config": "workspace:*",
    "@lumen/core": "workspace:*",
    "@lumen/llm": "workspace:*",
    "@lumen/memory": "workspace:*",
    "@lumen/mcp": "workspace:*",
    "@lumen/skills": "workspace:*",
    "@lumen/tools": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^18.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
