{
  "name": "lumen",
  "version": "0.1.0",
  "private": true,
  "description": "Lumen — a self-improving TypeScript agent framework",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "fmt": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test -- --watch",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "clean": "turbo run clean && rm -rf node_modules",
    "rebuild:native": "pnpm rebuild better-sqlite3 --filter @lumen/memory"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  }
}
