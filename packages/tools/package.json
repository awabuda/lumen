{
  "name": "@lumen/tools",
  "version": "0.18.5",
  "private": true,
  "description": "Default tool implementations for the Lumen agent: filesystem (read/write/patch/list/search), shell (with pluggable sandbox), git, gh CLI bridge, web search/fetch, meta tools (date/env/whoami), and chunk_text.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@lumen/core": "workspace:*",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
